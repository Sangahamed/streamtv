# Clé API TMDB (gratuite sur themoviedb.org)
TMDB_API_KEY=your_tmdb_api_key_here

# Clé API Football-Data (gratuite sur football-data.org)
FOOTBALL_DATA_API_KEY=your_football_data_key_here

# Optionnel : Redis / Vercel KV
# KV_URL=https://votre-projet.kv.vercel-storage.com
# KV_REST_API_TOKEN=votre_token

# URL publique de l'app
NEXT_PUBLIC_URL=http://localhost:3000

# Secret de signature du relais de flux (/api/tv/proxy). Obligatoire en
# production multi-instances (Vercel) : générer une valeur aléatoire longue.
# STREAM_PROXY_SECRET=

# Chaînes adultes (bouton 18+ sur /tv). Désactivé par défaut. À ne pas activer
# sur un site public en France sans vérification d'âge conforme (loi SREN/ARCOM).
# ENABLE_ADULT_CHANNELS=1
# Playlists M3U complémentaires pour le 18+ (iptv-org n'en publie plus),
# séparées par des virgules. Lues seulement si ENABLE_ADULT_CHANNELS=1.
# Les options #EXTVLCOPT:http-referrer / http-user-agent sont prises en charge.
# Les entrées sont rattachées à une chaîne adulte de l'annuaire iptv-org
# (tvg-id ou nom), sinon créées à part. Les flux chiffrés dont la clé exige un
# abonnement (erreur 401/403) sont marqués hors ligne.
# ADULT_M3U_URLS=https://adultiptv.net/chs.m3u,https://iptvmate.net/files/adult.m3u,https://raw.githubusercontent.com/wghub/Live/main/Adult.m3u

# Playlists M3U complémentaires (hors adulte), séparées par des virgules. Leurs
# flux sont rattachés aux chaînes de l'annuaire iptv-org : par tvg-id, sinon par
# nom (dans le pays indiqué, ou si le nom est unique dans l'annuaire). Les
# autres entrées deviennent des chaînes à part, classées par pays quand le
# group-title est un nom de pays.
# EXTRA_M3U_URLS=https://romaxa55.github.io/world_ip_tv/output/index.m3u,https://raw.githubusercontent.com/IPTVRU2026/IPTVMIR/main/IPTV_MEGA_PLAYLIST.m3u,https://raw.githubusercontent.com/abusaeeidx/IPTV-Scraper-Zilla/main/combined-playlist.m3u
